# Server — copy to .env.local (gitignored)

PORT=5000

# Local dev
CLIENT_URL=http://localhost:5173

# Vercel production (epicurean-havens-server project → Settings → Environment Variables):
# CLIENT_URL=https://epicurean-havens.vercel.app

MONGODB_URI=mongodb://127.0.0.1:27017/epicurean-haven
ADMIN_JWT_SECRET=change-me-in-production
IMGBB_API_KEY=your-imgbb-api-key

# Admin seed (run: npm run seed:admin)
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=User@123
ADMIN_NAME=Admin
